# Copy to .env and fill in. Never commit .env.
AUTH_SECRET="paste-random-32-chars"
NEXTAUTH_SECRET="paste-random-32-chars"
NEXTAUTH_URL="http://localhost:3000"
DATABASE_URL="file:./data/app.db"
GITHUB_TOKEN=""
GITHUB_WEBHOOK_SECRET=""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-on-first-login"

# Optional. Cached images and PDFs, one file per content hash. Put it on the
# same persistent volume as the database.
# ASSET_DIR="./data/assets"
# Optional. How often the app checks GitHub for new commits, 5 to 15 minutes.
# SYNC_INTERVAL_MINUTES="10"
# Optional. Set to "off" to disable the timed recheck (webhook and Sync now still work).
# SYNC_SCHEDULE="on"
